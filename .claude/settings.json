{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/model-routing-guard.ps1",
            "timeout": 10,
            "statusMessage": "Checking model routing (planning/review on the most capable model; implementation on cheaper ones)"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/sprint-close-guard.ps1",
            "timeout": 10,
            "statusMessage": "Checking sprint-close governance"
          }
        ]
      }
    ]
  }
}
