<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Npgsql" Version="8.0.3" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.12.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />

    <!-- Transitive CVE overrides per S39 TASK-3904 (2026-05-23):
         Microsoft.NET.Test.Sdk 17.8.0 pulls in old System.Net.Http 4.3.0 +
         System.Text.RegularExpressions 4.3.0 which carry High-severity CVEs
         (GHSA-7jgj-8wvc-jh57, GHSA-cmhx-cq75-c4mj). Explicit refs force
         resolution to patched 4.x releases. -->
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />

    <!-- Transitive CVE override (2026-08-13): Testcontainers.PostgreSql 3.9.0 pulls
         in SSH.NET 2023.0.0, which carries High-severity CVE-2026-48798 / GHSA-q939-rpr3-3284
         (ScpClient recursive-download path traversal; newly published, so the CI vuln
         gate began failing repo-wide). Test-only, and the suite never downloads from
         untrusted SCP servers, so no real exposure — but the gate fails on any transitive
         High CVE. Explicit ref forces the patched 2026.0.0. Also recorded as SEC-026 (A06). -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- S64: census-documented parallelism override (see xunit.runner.json) -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SharedKernel\StatsTid.SharedKernel\StatsTid.SharedKernel.csproj" />
    <ProjectReference Include="..\..\src\RuleEngine\StatsTid.RuleEngine.Api\StatsTid.RuleEngine.Api.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure\StatsTid.Infrastructure\StatsTid.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Backend\StatsTid.Backend.Api\StatsTid.Backend.Api.csproj" />
    <ProjectReference Include="..\..\src\Integrations\StatsTid.Integrations.Payroll\StatsTid.Integrations.Payroll.csproj" />
    <!-- SEC-023: boots the External integration host in-process (WebApplicationFactory)
         for the /api/external/send authorization + envelope-hardening end-to-end tests. -->
    <ProjectReference Include="..\..\src\Integrations\StatsTid.Integrations.External\StatsTid.Integrations.External.csproj" />
    <!-- SEC-021: boots the Orchestrator host in-process (WebApplicationFactory) for the
         GET /api/orchestrator/tasks/{id} read-authorization end-to-end tests (Docker-gated). -->
    <ProjectReference Include="..\..\src\Orchestrator\StatsTid.Orchestrator\StatsTid.Orchestrator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- S27 / TASK-2701 / Reviewer W1: copy canonical init.sql alongside the test bin
         output so StatsTidWebApplicationFactory.LocateInitSql() finds it on iteration 0
         in CI environments where bin/Debug/net8.0/ is detached from the source tree. -->
    <Content Include="..\..\docker\postgres\init.sql"
             Link="docker\postgres\init.sql"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
