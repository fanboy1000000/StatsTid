<Project>

  <!--
    Repo-root MSBuild props applied to every csproj automatically.
    Authored S39 TASK-3908 (2026-05-23); per-project opt-outs added
    by S39 TASK-3909 (same commit chain).

    Deduplicates Nullable + ImplicitUsings that were previously set
    on every csproj individually. Sets warn-as-error default ON;
    individual non-production projects opt OUT below.
  -->

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      Warn-as-error DEFAULT = TRUE. Production csprojs inherit this.
      Test projects, tooling, mock services, and specific deferred-debt
      production projects opt OUT below.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!--
      In-box .NET Analyzers (replaces unmaintained SecurityCodeScan.VS2019
      per Reviewer cycle-1 WARNING #4). EnableNETAnalyzers is implicitly
      true on net5.0+ but we set it explicitly for clarity.

      AnalysisLevel=latest opts into the newest analyzer pack shipped with
      the SDK. AnalysisModeSecurity=All enables ALL security-category rules
      (CA3xxx injection, CA5xxx cryptography/auth) at their default
      warning severity — which warn-as-error then elevates to errors on
      production projects. Other categories (Style/Reliability/Usage/etc.)
      stay at default; we don't want hundreds of stylistic warnings.
      S39 TASK-3910 (2026-05-23).
    -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisModeSecurity>All</AnalysisModeSecurity>
  </PropertyGroup>

  <!--
    Production opt-outs with explicit rationale.
    Each entry must cite the deferred-debt reason; cleanup is tracked
    in docs/QUALITY.md "Pre-S39 Warning Baseline" + a follow-up tooling
    sprint candidate.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'StatsTid.Integrations.Payroll'">
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!--
      QUAL-069 (S133 rationale; re-synced S134 QUAL-003). Measured on the current
      tree: exactly ONE unsuppressed CS0618 in this project — at the
      `calculator.CalculateWithOutcomeAsync(request.Profile, …)` CALL SITE inside the
      `MapPost("/api/payroll/calculate-and-export", …)` handler in Program.cs. (Durable
      by-name reference, NOT a line number — the line moved from :272 to :282 within
      S134 itself when TASK-13403 inserted the denial middleware above it, which is
      exactly the anchor-rot class QUAL-090/QUAL-012 fixed; grep the call, don't trust a
      number.) That call target is the deferred-retirement [Obsolete] PLANLESS
      `PeriodCalculationService.CalculateWithOutcomeAsync(EmploymentProfile, …)`
      overload (the outcome-returning sibling of the legacy planless
      `CalculateAsync(EmploymentProfile, …)`, ADDED in S134 QUAL-003 so the endpoint
      can thread the calc's manifest-id into the audit trail — see TASK-13404).
      S134 moved the endpoint's call from the legacy `CalculateAsync` shim to this
      new sibling; the sibling is marked [Obsolete] on purpose so exactly ONE live
      CS0618 remains and this project-wide opt-out stays LOAD-BEARING (dropping it to
      zero while the planless boundary-limited shims are unretired would silently make
      the opt-out inert — precisely QUAL-069's own defect class). There is still a
      SECOND caller of the ORIGINAL `CalculateAsync(EmploymentProfile, …)` overload —
      RetroactiveCorrectionService.cs:210 — wrapped in a local
      `#pragma warning disable CS0618`, so it does not trip the gate.

      STATUS: DEFERRED (QUAL-069, per OQ-5). The gate stays OFF until the planless
      boundary-limited shims (`CalculateAsync` + the S134 `CalculateWithOutcomeAsync`
      sibling) retire (that clears the endpoint's call site and the pragma together). A
      narrower fix — a targeted `#pragma warning disable CS0618` at that call site so
      project-wide warn-as-error could be restored now — is deliberately NOT taken;
      it rides the legacy-overload-retirement follow-up.
    -->
  </PropertyGroup>

  <!--
    Non-production opt-outs (no rationale needed — these are by design):
    - Test projects: intentionally exercise [Obsolete] APIs to validate
      deprecation paths. Note: cannot use $(IsTestProject) here because
      Directory.Build.props is evaluated BEFORE the csproj sets that
      property; must enumerate project names instead.
    - Tooling projects: ProjectionBackfill is a one-shot migration tool;
      strict mode adds friction without value.

    QUAL-072 (S133): MockPayroll / MockExternal REMOVED from this list. Before
    S133 they sat outside every compiled gate (not in StatsTid.sln, and the
    Docker build context excludes this repo-root props file), so these two
    opt-out entries were UNREACHABLE — they described a regime that never ran.
    QUAL-074 brought both mock hosts into StatsTid.sln, so the gated build now
    compiles them WITH this props file applied. Observed on the gated tree they
    build CLEAN under the full analyzer suite + warn-as-error (0 warnings), so
    the opt-outs were not needed to keep them green — the mock hosts are now
    held to the same warn-as-error bar as production. If a future stub edit
    introduces a genuinely-benign warning, re-add the specific project here with
    a cited rationale (do NOT blanket-disable), or NoWarn the specific rule.
  -->
  <PropertyGroup Condition="
       '$(MSBuildProjectName)' == 'StatsTid.Tests.Unit'
    OR '$(MSBuildProjectName)' == 'StatsTid.Tests.Regression'
    OR '$(MSBuildProjectName)' == 'StatsTid.Tests.Smoke'
    OR '$(MSBuildProjectName)' == 'ProjectionBackfill'
    OR '$(MSBuildProjectName)' == 'StatsTid.DemoSeed'
    OR '$(MSBuildProjectName)' == 'StatsTid.Tests.DemoSeed'">
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
